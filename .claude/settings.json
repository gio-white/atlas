{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pytest *)",
      "Bash(pnpm install *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)"
    ],
    "deny": [
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(poetry *)",
      "Bash(pipenv *)",
      "Bash(uv pip *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(bunx *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce_toolchain.py\"",
            "timeout": 10,
            "statusMessage": "Checking uv / pnpm toolchain rule"
          }
        ]
      }
    ]
  }
}
